+export const LOCAL_MUSIC_SCAN_PROGRESS_EVENT = 'folia-local-music-scan-progress';
+
+const loadLocalMusic = () => import('./localMusicService');
+type LocalOperation = {
+    [K in keyof typeof LocalMusic]: (typeof LocalMusic)[K] extends (...args: never[]) => Promise<unknown> ? K : never
+}[keyof typeof LocalMusic];
+
+function deferLocal<K extends LocalOperation>(name: K): (typeof LocalMusic)[K] {
+    return ((...args: never[]) => loadLocalMusic().then(loaded => {
+        const run = loaded[name] as (...input: never[]) => Promise<unknown>;
+        return run(...args);
+    })) as (typeof LocalMusic)[K];
+}
+
+export const getLocalSongArrayBuffer = deferLocal('getLocalSongArrayBuffer');
+export const getAudioFromLocalSong = deferLocal('getAudioFromLocalSong');
+export const getFileFromLocalSong = deferLocal('getFileFromLocalSong');
+export const ensureLocalSongCoverAsset = deferLocal('ensureLocalSongCoverAsset');
+export const importFolder = deferLocal('importFolder');
+export const resyncAllFolders = deferLocal('resyncAllFolders');
+export const resyncFolder = deferLocal('resyncFolder');
+export const clearFolderIgnore = deferLocal('clearFolderIgnore');
+export const deleteFolderSongs = deferLocal('deleteFolderSongs');
+export const deleteSongsByIds = deferLocal('deleteSongsByIds');
+export const removeImportedRoot = deferLocal('removeImportedRoot');
